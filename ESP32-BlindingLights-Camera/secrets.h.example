/**
 * Wi-Fi credentials for the ESP32 camera sketch.
 *
 * Setup:
 *   1. Copy this file to secrets.h (same folder as the .ino):
 *        cp secrets.h.example secrets.h
 *   2. Edit secrets.h with your real SSID and password.
 *
 * secrets.h is gitignored — never commit it.
 */
#ifndef DIARY_CAM_SECRETS_H
#define DIARY_CAM_SECRETS_H

static const char *WIFI_SSID = "your-wifi-ssid";
static const char *WIFI_PASS = "your-wifi-password";

#endif
